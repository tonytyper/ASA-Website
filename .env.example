# Copy to .env.local and fill in from the Supabase dashboard:
# Project Settings -> API Keys.

# Both of these ship to the browser. That is by design — row level security,
# not key secrecy, is what protects the data (see supabase/migrations).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Server-side only. Bypasses row level security, and is read solely by
# `npm run gallery:ingest`. Never give this the NEXT_PUBLIC_ prefix, and never
# add it to the hosting provider's build environment — the site does not use it.
SUPABASE_SECRET_KEY=sb_secret_...

# Lets `npm run gallery:ingest` refresh the live site's cached gallery when it
# finishes, so new albums appear on the next visit rather than within the hour.
# REVALIDATE_SECRET must hold the same value here and in the hosting provider's
# environment; generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# SITE_URL must be the final address after any redirect (the www host), since
# the secret is sent in a header that fetch drops on a cross-origin redirect.
SITE_URL=https://www.asaofunlv.com
REVALIDATE_SECRET=
