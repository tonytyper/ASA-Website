# Copy to .env.local and fill in from the Supabase dashboard:
# Project Settings -> API Keys.

# Both of these ship to the browser. That is by design — row level security,
# not key secrecy, is what protects the data (see supabase/migrations).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Server-side only. Bypasses row level security, and is read solely by
# `npm run gallery:ingest`. Never give this the NEXT_PUBLIC_ prefix, and never
# add it to the hosting provider's build environment — the site does not use it.
SUPABASE_SECRET_KEY=sb_secret_...
